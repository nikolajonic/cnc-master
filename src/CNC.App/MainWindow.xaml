<Window x:Class="CNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CNC.App.ViewModels"
        xmlns:views="clr-namespace:CNC.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeNormal}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Grid Margin="8,0,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: application, machine, live status -->
    <DockPanel Grid.Row="0" Margin="8,10,4,4" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
        <TextBlock Style="{StaticResource TextBase}" FontSize="16" FontWeight="SemiBold" Text="{Binding ApplicationName}" />
        <TextBlock Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeNormal}" Margin="10,1,0,0" Text="{Binding MachineName}" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Exit" Command="{Binding ExitCommand}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="About" Command="{Binding AboutCommand}" />
      <views:MachineStatusView DataContext="{Binding Status}" ClipToBounds="True" />
    </DockPanel>

    <!-- Main work area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
          <views:DroView DataContext="{Binding Dro}" />
          <views:JogView DataContext="{Binding Jog}" />
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <views:ToolpathView Grid.Row="0" DataContext="{Binding Toolpath}" />
        <views:GCodeViewerView Grid.Row="1" DataContext="{Binding GCode}" />
      </Grid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
          <views:MachineControlsView DataContext="{Binding MachineControls}" />
          <views:ProgramControlView DataContext="{Binding Program}" />
          <views:FeedSpindleView DataContext="{Binding FeedSpindle}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="2" Margin="8,2,8,6">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="600">
        <Run Text="Logs  " /><Run Text="{Binding LogsDirectory, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
    </DockPanel>
  </Grid>
</Window>
