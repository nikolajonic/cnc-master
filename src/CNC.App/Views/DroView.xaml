<UserControl x:Class="CNC.App.Views.DroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DroViewModel}">

  <HeaderedContentControl Style="{StaticResource Panel}">
    <HeaderedContentControl.Header>
      <DockPanel>
        <TextBlock Text="DRO" />
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding Units}" />
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}" Text="{Binding WorkCoordinateSystem}" />
        <Border />
      </DockPanel>
    </HeaderedContentControl.Header>

    <StackPanel>
      <!-- Column headings -->
      <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Style="{StaticResource LabelText}" HorizontalAlignment="Right" Text="WORK" />
        <TextBlock Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" Text="MACHINE" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Axes}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:AxisReadoutViewModel}">
            <Border Background="{StaticResource InsetBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,2"
                    Padding="4,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DroAxisText}" Text="{Binding AxisName}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DroValueText}" Text="{Binding WorkPositionText}" />
                <TextBlock Grid.Column="2" Style="{StaticResource DroSecondaryValueText}" Text="{Binding MachinePositionText}" />
                <Button Grid.Column="3"
                        Content="ZERO"
                        FontSize="{StaticResource FontSizeSmall}"
                        Command="{Binding DataContext.ZeroAxisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding AxisName}"
                        ToolTip="Set the current work position of this axis to zero" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel Margin="0,4,0,0">
        <Button DockPanel.Dock="Right" Content="ZERO ALL" MinWidth="90" Command="{Binding ZeroAllCommand}" />
        <ToggleButton DockPanel.Dock="Left"
                      MinWidth="70"
                      IsChecked="{Binding IsRelative}"
                      Content="{Binding DistanceModeText}"
                      ToolTip="Toggle absolute / relative display" />
        <Border />
      </DockPanel>
    </StackPanel>
  </HeaderedContentControl>
</UserControl>
