<UserControl x:Class="CNC.App.Views.ToolpathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolpathViewModel}">

  <HeaderedContentControl Style="{StaticResource Panel}">
    <HeaderedContentControl.Header>
      <DockPanel>
        <TextBlock Text="TOOLPATH" />
        <ListBox DockPanel.Dock="Right"
                 Width="150"
                 Style="{StaticResource SegmentedListBox}"
                 ItemsSource="{Binding Planes}"
                 SelectedItem="{Binding SelectedPlane}" />
        <Border />
      </DockPanel>
    </HeaderedContentControl.Header>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Stretch="None">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="{StaticResource InsetBackgroundBrush}">
                <GeometryDrawing.Geometry>
                  <RectangleGeometry Rect="0,0,40,40" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
              <GeometryDrawing>
                <GeometryDrawing.Pen>
                  <Pen Brush="{StaticResource PanelHeaderBackgroundBrush}" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                    <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                  </GeometryGroup>
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>

      <TextBlock HorizontalAlignment="Center"
                 Style="{StaticResource LabelText}"
                 FontSize="{StaticResource FontSizeLarge}"
                 Text="No program loaded" />
    </Border>
  </HeaderedContentControl>
</UserControl>
