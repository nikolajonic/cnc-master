<UserControl x:Class="CNC.App.Views.MachineStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MachineStatusViewModel}">

  <UserControl.Resources>
    <Style x:Key="Metric" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="18,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <DockPanel LastChildFill="False">

    <!-- Machine state -->
    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" ToolTip="Machine state">
      <StackPanel Orientation="Horizontal">
        <Ellipse>
          <Ellipse.Style>
            <Style TargetType="Ellipse" BasedOn="{StaticResource ChipDot}">
              <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                  <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                  <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Stopping">
                  <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Resetting">
                  <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Alarm">
                  <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="EmergencyStop">
                  <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding StateText}" />
      </StackPanel>
    </Border>

    <!-- Connection -->
    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" ToolTip="Controller connection">
      <StackPanel Orientation="Horizontal">
        <Ellipse>
          <Ellipse.Style>
            <Style TargetType="Ellipse" BasedOn="{StaticResource ChipDot}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
              <Setter Property="Text" Value="Not connected" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Text" Value="Connected" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Controller mode -->
    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" ToolTip="Controller mode">
      <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ControllerMode}" />
    </Border>

    <!-- Emergency stop: only shown while active, as a solid red pill. -->
    <Border DockPanel.Dock="Left" Background="{StaticResource DangerBrush}">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEmergencyStopActive}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" Text="Emergency stop active" />
    </Border>

    <StackPanel DockPanel.Dock="Left" Style="{StaticResource Metric}">
      <TextBlock Style="{StaticResource MetricLabel}" Text="Feed" />
      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding FeedRate, StringFormat={}{0:0.0}}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Style="{StaticResource Metric}">
      <TextBlock Style="{StaticResource MetricLabel}" Text="Spindle" />
      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding SpindleRpm, StringFormat={}{0:0} rpm}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Style="{StaticResource Metric}">
      <TextBlock Style="{StaticResource MetricLabel}" Text="Program" />
      <TextBlock Style="{StaticResource MetricValue}" MaxWidth="200" Text="{Binding ProgramName}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Style="{StaticResource Metric}">
      <TextBlock Style="{StaticResource MetricLabel}" Text="Line" />
      <TextBlock Style="{StaticResource MetricValue}" MaxWidth="220" FontFamily="{StaticResource MonoFont}" FontWeight="Normal" Text="{Binding ActiveLine}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Style="{StaticResource Metric}">
      <TextBlock Style="{StaticResource MetricLabel}" Text="Controller" />
      <TextBlock Style="{StaticResource MetricValue}" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ControllerStatus}" />
    </StackPanel>
  </DockPanel>
</UserControl>
