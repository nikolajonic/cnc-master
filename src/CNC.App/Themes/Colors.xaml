<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Neutral dark surfaces plus three accents:
      Accent  (blue)  - primary actions, selection, normal operation
      Warning (amber) - paused, feed hold, attention required
      Danger  (red)   - alarm, limit, emergency stop
  -->

  <Color x:Key="WindowBackgroundColor">#FF141519</Color>
  <Color x:Key="CardColor">#FF1C1E23</Color>
  <Color x:Key="CardBorderColor">#FF282B31</Color>
  <Color x:Key="InsetColor">#FF16181C</Color>
  <Color x:Key="ControlColor">#FF2A2D34</Color>
  <Color x:Key="ControlHoverColor">#FF33373F</Color>
  <Color x:Key="ControlPressedColor">#FF3C414A</Color>
  <Color x:Key="DividerColor">#FF2A2D33</Color>

  <Color x:Key="TextPrimaryColor">#FFECEDEF</Color>
  <Color x:Key="TextSecondaryColor">#FF8D939C</Color>
  <Color x:Key="TextDisabledColor">#FF5A5F68</Color>
  <Color x:Key="OnAccentColor">#FFFFFFFF</Color>

  <Color x:Key="AccentColor">#FF3D8BFD</Color>
  <Color x:Key="AccentHoverColor">#FF5C9DFD</Color>
  <Color x:Key="AccentSoftColor">#FF1C2E4D</Color>
  <Color x:Key="AccentTextColor">#FF8AB8FF</Color>
  <Color x:Key="WarningColor">#FFF5A524</Color>
  <Color x:Key="WarningSoftColor">#FF3A2E16</Color>
  <Color x:Key="DangerColor">#FFE5484D</Color>
  <Color x:Key="DangerHoverColor">#FFEC5D62</Color>
  <Color x:Key="DangerPressedColor">#FFC93C41</Color>
  <Color x:Key="DangerSoftColor">#FF3B1D20</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
  <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
  <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
  <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

</ResourceDictionary>
