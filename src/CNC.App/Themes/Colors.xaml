<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Palette: neutral dark greys plus exactly three accents.
      Accent  (cyan)  - active / selected / normal operation
      Warning (amber) - paused, feed hold, attention required
      Danger  (red)   - alarm, limit, emergency stop
  -->

  <Color x:Key="WindowBackgroundColor">#FF16181C</Color>
  <Color x:Key="PanelBackgroundColor">#FF1F2227</Color>
  <Color x:Key="PanelHeaderBackgroundColor">#FF262A30</Color>
  <Color x:Key="InsetBackgroundColor">#FF0F1114</Color>
  <Color x:Key="ControlBackgroundColor">#FF2C3037</Color>
  <Color x:Key="ControlHoverBackgroundColor">#FF363B43</Color>
  <Color x:Key="ControlPressedBackgroundColor">#FF41474F</Color>
  <Color x:Key="BorderColor">#FF3A3F47</Color>
  <Color x:Key="BorderStrongColor">#FF545B65</Color>

  <Color x:Key="TextPrimaryColor">#FFE8EAED</Color>
  <Color x:Key="TextSecondaryColor">#FF9AA1AB</Color>
  <Color x:Key="TextDisabledColor">#FF5D636C</Color>

  <Color x:Key="AccentColor">#FF2EC4E6</Color>
  <Color x:Key="AccentDimColor">#FF15495A</Color>
  <Color x:Key="WarningColor">#FFF2A900</Color>
  <Color x:Key="WarningDimColor">#FF4A3A10</Color>
  <Color x:Key="DangerColor">#FFE5383B</Color>
  <Color x:Key="DangerDimColor">#FF4D1A1C</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
  <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="{StaticResource PanelHeaderBackgroundColor}" />
  <SolidColorBrush x:Key="InsetBackgroundBrush" Color="{StaticResource InsetBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="{StaticResource ControlHoverBackgroundColor}" />
  <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="{StaticResource ControlPressedBackgroundColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource WarningDimColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerDimBrush" Color="{StaticResource DangerDimColor}" />

</ResourceDictionary>
